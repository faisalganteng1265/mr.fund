# Names only. Copy to .env (gitignored) and fill locally. Never commit values that are secret.
# Source of truth: docs/technical/INTEGRATIONS.md "Environment variables".

# Network (public)
NEAR_NETWORK_ID=
NEAR_RPC_URL=
# Browser copies of the two above (Next.js exposes only NEXT_PUBLIC_*)
NEXT_PUBLIC_NEAR_NETWORK_ID=
NEXT_PUBLIC_NEAR_RPC_URL=
# Public Auth0 application id, never a client secret. Testnet defaults to the
# documented shared development client; mainnet Auth stays disabled without an approved id.
NEXT_PUBLIC_NEAR_AUTH_CLIENT_ID=

# Contract and account ids (public)
RHEA_LENDING_ID=
GUARDIAN_FACTORY_ID=
FEE_RECIPIENT_ID=
WATCHER_ACCOUNT_ID=
# Browser copies for the execution verifier; must equal the two above. Missing blocks Execute.
NEXT_PUBLIC_RHEA_LENDING_ID=
NEXT_PUBLIC_FEE_RECIPIENT_ID=
# Live Guardian panel: browser copy of GUARDIAN_FACTORY_ID and the decided per-action fee
# (debt-token atomic units, D24). Missing values block Guardian setup.
NEXT_PUBLIC_GUARDIAN_FACTORY_ID=
NEXT_PUBLIC_GUARDIAN_ACTION_FEE_ATOMIC=

# Chat draft fees: all fields must be configured explicitly to enable repayment cards.
# Amounts are integers in FEE_TOKEN_ID atomic units. Empty does not mean zero.
FEE_TOKEN_ID=
FEE_ACTIVATION_ATOMIC=
FEE_ACTION_ATOMIC=
FEE_EXECUTION_ATOMIC=

# Plain-wallet opening (deposit, then a separate borrow). Empty keeps the opening tools at
# "not available". The pair must be one collateral token and one different debt token on the
# configured network; the browser copies must equal the server values. Fee: omit OPENING_FEE_ATOMIC
# for "no approved fee policy yet" (the draft is refused); 0 is an explicit approved "no fee";
# a positive amount needs the complete FEE_* schedule above and is paid in FEE_TOKEN_ID.
OPENING_COLLATERAL_TOKEN_ID=
OPENING_DEBT_TOKEN_ID=
OPENING_DEFAULT_TARGET_BPS=
OPENING_FEE_ATOMIC=
NEXT_PUBLIC_OPENING_COLLATERAL_TOKEN_ID=
NEXT_PUBLIC_OPENING_DEBT_TOKEN_ID=

# Watcher (secret path: directory of function-call key files, one per Guardian)
WATCHER_KEYS_DIR=

# Chat API only (secret)
NEARAI_API_KEY=
NEARAI_BASE_URL=
# Default model chosen by the user 2026-11-13: anthropic/claude-haiku-5-5 (D25; see CHAT-API).
NEARAI_MODEL=

# Optional trusted reverse proxy. Configure ALL three only behind an edge that
# overwrites these headers and prevents direct origin access. Never NEXT_PUBLIC_*.
CHAT_PROXY_SECRET=
CHAT_PROXY_SECRET_HEADER=
CHAT_PROXY_IP_HEADER=

# Freshness limit for advice and cards, milliseconds (default proposal 120000)
MAX_DATA_AGE_MS=

# Standalone API server (apps/api). The web build points the browser at it; leave unset to use
# the same-origin Next routes. The API is public: see docs/technical/CHAT-API.md.
NEXT_PUBLIC_API_URL=
API_PORT=
API_HOST=
API_CORS_ORIGIN=
