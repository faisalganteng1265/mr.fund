{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "files": {
    "includes": [
      "apps/**/*.{ts,tsx,json}",
      "packages/**/*.{ts,tsx,json}",
      "*.{ts,json}",
      "!**/node_modules",
      "!**/.next",
      "!**/next-env.d.ts",
      "!**/tsconfig.tsbuildinfo"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  }
}
