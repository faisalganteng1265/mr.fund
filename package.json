{
  "name": "mr-fund",
  "private": true,
  "version": "0.0.0",
  "description": "Mr.Fund: the DeFi manager you can talk to.",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "contracts:test": "cargo test --manifest-path contracts/Cargo.toml",
    "contracts:probe:prepare": "node scripts/probes/prepare-sandbox.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
